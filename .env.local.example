# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit it.

# PostgreSQL connection string from Vercel Postgres (or Neon/Supabase).
# Vercel injects this automatically when the database is connected in the dashboard.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# A long random string used to sign session cookies.
# Generate with: openssl rand -base64 32
SESSION_SECRET="replace-me-with-a-long-random-string"
