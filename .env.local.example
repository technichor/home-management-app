# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit it.

# PostgreSQL connection string from Vercel Postgres (or Neon/Supabase).
# Vercel injects this automatically when the database is connected in the dashboard.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# A long random string used to sign session cookies.
# Generate with: openssl rand -base64 32
SESSION_SECRET="replace-me-with-a-long-random-string"

# The code a person must enter on /setup to create a household account.
# Leave it unset to close signup entirely. Set it in Vercel too, and share it only
# with people you want to be able to create an account.
SETUP_CODE="replace-me-with-a-shared-code"
