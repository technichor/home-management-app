# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit it.

# PostgreSQL connection string from Vercel Postgres (or Neon/Supabase).
# Vercel injects this automatically when the database is connected in the dashboard.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# A long random string used to sign session cookies.
# Generate with: openssl rand -base64 32
SESSION_SECRET="replace-me-with-a-long-random-string"

# Password-reset email (Resend). Without RESEND_API_KEY the email is printed to the server log.
RESEND_API_KEY=""
# Defaults to Resend's test sender, which only delivers to your own Resend account address.
# Set to an address on a domain you've verified in Resend to email anyone.
EMAIL_FROM=""
# The site's public URL, used in emailed links. On Vercel the production URL is used if unset.
APP_URL=""
