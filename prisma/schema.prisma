generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContactCategory {
  FAMILY_FRIEND
  SERVICE_PROVIDER
  MEDICAL_SCHOOL
  HOUSEHOLD_ADMIN
}

enum ListSortMode {
  MANUAL
  PAIRWISE
}

enum SyncStatus {
  PENDING
  ACTIVE
  DECLINED
  REVOKED
}

enum ConversationScope {
  HOUSEHOLD
  SYNCED
}

enum EntityType {
  CONTACT
  HOUSEHOLD
}

enum ActivityAction {
  CREATED
  UPDATED
  DELETED
  RESTORED
}

enum ActivitySource {
  CSV_IMPORT
  MANUAL
}

model Household {
  id              String    @id @default(cuid())
  displayName     String
  mailingAddress  String?
  tags            String[]
  notes           String?
  urlSlug         String?   @unique
  passwordHash    String?
  headOfHousehold String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  contacts       Contact[]
  importVersions ImportVersion[]
  lists          List[]

  syncsInitiated Sync[]         @relation("SyncInitiator")
  syncsReceived  Sync[]         @relation("SyncCounterpart")
  conversations  Conversation[]
}

model Contact {
  id                  String          @id @default(cuid())
  householdId         String?
  household           Household?      @relation(fields: [householdId], references: [id])
  firstName           String
  lastName            String
  nickname            String?
  category            ContactCategory
  address             String?
  phoneMobile         String?
  phoneHome           String?
  phoneWork           String?
  emailPrimary        String?
  emailSecondary      String?
  tags                String[]
  favorite            Boolean         @default(false)
  relationshipNotes   String?
  linkedFamilyMember  String?
  importantDate1      String?
  importantDate1Label String?
  importantDate2      String?
  importantDate2Label String?
  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?

  assignedListItems ListItem[]

  syncs         Sync[]
  conversations Conversation[]
  sentMessages  Message[]
}

// Polymorphic log — entityId can reference either a Contact or Household id.
// No FK constraint intentionally; the entityType field disambiguates.
model ActivityLogEntry {
  id            String         @id @default(cuid())
  entityType    EntityType
  entityId      String
  action        ActivityAction
  changedFields Json?
  source        ActivitySource
  timestamp     DateTime       @default(now())
}

model ImportVersion {
  id                 String    @id @default(cuid())
  householdId        String
  household          Household @relation(fields: [householdId], references: [id])
  importedAt         DateTime  @default(now())
  summary            Json
  contactsSnapshot   Json
  householdsSnapshot Json
}

model List {
  id          String       @id @default(cuid())
  householdId String
  household   Household    @relation(fields: [householdId], references: [id])
  name        String
  tags        String[]
  archivedAt  DateTime?
  sortMode    ListSortMode @default(MANUAL)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  items ListItem[]
}

model ListItem {
  id                  String    @id @default(cuid())
  listId              String
  list                List      @relation(fields: [listId], references: [id], onDelete: Cascade)
  text                String
  quantity            String?
  assignedToContactId String?
  assignedToContact   Contact?  @relation(fields: [assignedToContactId], references: [id], onDelete: SetNull)
  notes               String?
  checked             Boolean   @default(false)
  checkedAt           DateTime?
  position            Int
  rating              Float     @default(1500)
  comparisonCount     Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// A household-to-household handshake, attached to the Contact it was started from.
// A contact counts as "synced" when an ACTIVE Sync points at it (derived, not stored on Contact).
// counterpartHouseholdId stays null until the invited household is a real account.
// Rules (scope/FK pairing, one open sync per contact) are enforced in the app layer with Zod,
// like the other conditional rules in this project, not as DB constraints.
model Sync {
  id                     String     @id @default(cuid())
  initiatingHouseholdId  String
  initiatingHousehold    Household  @relation("SyncInitiator", fields: [initiatingHouseholdId], references: [id], onDelete: Restrict)
  counterpartHouseholdId String?
  counterpartHousehold   Household? @relation("SyncCounterpart", fields: [counterpartHouseholdId], references: [id], onDelete: Restrict)
  relatedContactId       String
  relatedContact         Contact    @relation(fields: [relatedContactId], references: [id], onDelete: Restrict)
  counterpartEmail       String
  status                 SyncStatus @default(PENDING)
  createdAt              DateTime   @default(now())
  respondedAt            DateTime?

  conversations Conversation[]

  @@index([initiatingHouseholdId])
  @@index([counterpartHouseholdId])
  @@index([relatedContactId])
}

// scope HOUSEHOLD: householdId is set, syncId is null. scope SYNCED: syncId is set.
// relatedContactId marks a thread kept against one specific contact.
model Conversation {
  id               String            @id @default(cuid())
  scope            ConversationScope
  householdId      String?
  household        Household?        @relation(fields: [householdId], references: [id], onDelete: Restrict)
  syncId           String?
  sync             Sync?             @relation(fields: [syncId], references: [id], onDelete: Restrict)
  relatedContactId String?
  relatedContact   Contact?          @relation(fields: [relatedContactId], references: [id], onDelete: Restrict)
  name             String
  archivedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  messages Message[]

  @@index([householdId])
  @@index([syncId])
  @@index([relatedContactId])
}

// Messages are never edited and never hard-deleted; deletedAt is the only removal.
model Message {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  senderContactId String
  sender          Contact      @relation(fields: [senderContactId], references: [id], onDelete: Restrict)
  text            String
  attachmentIds   String[]
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())

  @@index([conversationId, createdAt])
}
