generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContactCategory {
  FAMILY_FRIEND
  SERVICE_PROVIDER
  MEDICAL_SCHOOL
  HOUSEHOLD_ADMIN
}

enum ListSortMode {
  MANUAL
  PAIRWISE
}

enum SyncStatus {
  PENDING
  ACTIVE
  DECLINED
  REVOKED
}

enum ConversationScope {
  HOUSEHOLD
  SYNCED
}

enum EntityType {
  CONTACT
  HOUSEHOLD
}

enum ActivityAction {
  CREATED
  UPDATED
  DELETED
  RESTORED
}

enum ActivitySource {
  CSV_IMPORT
  MANUAL
}

model Household {
  id               String    @id @default(cuid())
  displayName      String
  mailingAddress   String?
  tags             String[]
  notes            String?
  urlSlug          String?   @unique
  passwordHash     String?
  headOfHousehold  String?
  // The one Contact this account acts as: the sender of its messages, and the "head" who
  // answers sync invites. Everyone sharing the household password acts as this contact.
  accountContactId String?
  accountContact   Contact?  @relation("AccountContact", fields: [accountContactId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  contacts       Contact[]       @relation("HouseholdContacts")
  importVersions ImportVersion[]
  lists          List[]

  syncsInitiated      Sync[]            @relation("SyncInitiator")
  syncsReceived       Sync[]            @relation("SyncCounterpart")
  conversations       Conversation[]
  members             User[]
  // Whose directory this record sits in. Null for a household that is itself an account (its
  // directory is the one it owns); set for the passive households an account recorded.
  ownerHouseholdId    String?
  ownerHousehold      Household?        @relation("Directory", fields: [ownerHouseholdId], references: [id], onDelete: Restrict)
  directoryHouseholds Household[]       @relation("Directory")
  directoryContacts   Contact[]         @relation("ContactDirectory")
  // Optional code that lets a signed-in user without a household ask to join; owners approve.
  joinCode            String?           @unique
  invites             HouseholdInvite[]
  joinRequests        JoinRequest[]

  @@index([ownerHouseholdId])
}

model Contact {
  id                  String          @id @default(cuid())
  householdId         String?
  household           Household?      @relation("HouseholdContacts", fields: [householdId], references: [id])
  firstName           String
  lastName            String
  nickname            String?
  category            ContactCategory
  address             String?
  phoneMobile         String?
  phoneHome           String?
  phoneWork           String?
  emailPrimary        String?
  emailSecondary      String?
  tags                String[]
  favorite            Boolean         @default(false)
  relationshipNotes   String?
  linkedFamilyMember  String?
  importantDate1      String?
  importantDate1Label String?
  importantDate2      String?
  importantDate2Label String?
  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?

  assignedListItems ListItem[]

  syncs                Sync[]
  conversations        Conversation[]
  sentMessages         Message[]
  accountForHouseholds Household[]    @relation("AccountContact")
  user                 User?
  // The account household whose directory this contact is in (everything is scoped by it).
  ownerHouseholdId     String?
  ownerHousehold       Household?     @relation("ContactDirectory", fields: [ownerHouseholdId], references: [id], onDelete: Restrict)

  @@index([ownerHouseholdId])
}

// Polymorphic log — entityId can reference either a Contact or Household id.
// No FK constraint intentionally; the entityType field disambiguates.
model ActivityLogEntry {
  id            String         @id @default(cuid())
  entityType    EntityType
  entityId      String
  action        ActivityAction
  changedFields Json?
  source        ActivitySource
  timestamp     DateTime       @default(now())
}

model ImportVersion {
  id                 String    @id @default(cuid())
  householdId        String
  household          Household @relation(fields: [householdId], references: [id])
  importedAt         DateTime  @default(now())
  summary            Json
  contactsSnapshot   Json
  householdsSnapshot Json
}

model List {
  id          String       @id @default(cuid())
  householdId String
  household   Household    @relation(fields: [householdId], references: [id])
  name        String
  tags        String[]
  archivedAt  DateTime?
  sortMode    ListSortMode @default(MANUAL)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  items ListItem[]
}

model ListItem {
  id                  String    @id @default(cuid())
  listId              String
  list                List      @relation(fields: [listId], references: [id], onDelete: Cascade)
  text                String
  quantity            String?
  assignedToContactId String?
  assignedToContact   Contact?  @relation(fields: [assignedToContactId], references: [id], onDelete: SetNull)
  notes               String?
  checked             Boolean   @default(false)
  checkedAt           DateTime?
  position            Int
  rating              Float     @default(1500)
  comparisonCount     Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// A household-to-household handshake, attached to the Contact it was started from.
// A contact counts as "synced" when an ACTIVE Sync points at it (derived, not stored on Contact).
// counterpartHouseholdId stays null until the invited household is a real account.
// Rules (scope/FK pairing, one open sync per contact) are enforced in the app layer with Zod,
// like the other conditional rules in this project, not as DB constraints.
model Sync {
  id                     String     @id @default(cuid())
  initiatingHouseholdId  String
  initiatingHousehold    Household  @relation("SyncInitiator", fields: [initiatingHouseholdId], references: [id], onDelete: Restrict)
  counterpartHouseholdId String?
  counterpartHousehold   Household? @relation("SyncCounterpart", fields: [counterpartHouseholdId], references: [id], onDelete: Restrict)
  relatedContactId       String
  relatedContact         Contact    @relation(fields: [relatedContactId], references: [id], onDelete: Restrict)
  counterpartEmail       String
  // SHA-256 of the invite token in the accept/decline link. The token itself is shown once.
  inviteTokenHash        String     @unique
  status                 SyncStatus @default(PENDING)
  createdAt              DateTime   @default(now())
  respondedAt            DateTime?

  conversations Conversation[]

  @@index([initiatingHouseholdId])
  @@index([counterpartHouseholdId])
  @@index([relatedContactId])
}

// scope HOUSEHOLD: householdId is set, syncId is null. scope SYNCED: syncId is set.
// relatedContactId marks a thread kept against one specific contact.
model Conversation {
  id               String            @id @default(cuid())
  scope            ConversationScope
  householdId      String?
  household        Household?        @relation(fields: [householdId], references: [id], onDelete: Restrict)
  syncId           String?
  sync             Sync?             @relation(fields: [syncId], references: [id], onDelete: Restrict)
  relatedContactId String?
  relatedContact   Contact?          @relation(fields: [relatedContactId], references: [id], onDelete: Restrict)
  name             String
  archivedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  messages Message[]

  @@index([householdId])
  @@index([syncId])
  @@index([relatedContactId])
}

// Messages are never edited and never hard-deleted; deletedAt is the only removal.
model Message {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  senderContactId String
  sender          Contact      @relation(fields: [senderContactId], references: [id], onDelete: Restrict)
  text            String
  attachmentIds   String[]
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())

  @@index([conversationId, createdAt])
}

enum UserRole {
  OWNER
  MEMBER
}

// An individual login (email + own password). A user belongs to at most one household and is
// not usable for any household feature until they do; contactId is the Contact they act as.
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole   @default(MEMBER)
  householdId  String?
  household    Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)
  contactId    String?    @unique
  contact      Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  invitesCreated    HouseholdInvite[]    @relation("InvitesCreated")
  invitesAccepted   HouseholdInvite[]    @relation("InvitesAccepted")
  joinRequests      JoinRequest[]
  // Sessions started before this are signed out (set on password change/reset).
  passwordChangedAt DateTime?
  resetTokens       PasswordResetToken[]

  @@index([householdId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

// A single-use link an owner sends to bring one person into the household. Only the token's
// SHA-256 is stored; the link is shown once.
model HouseholdInvite {
  id           String       @id @default(cuid())
  householdId  String
  household    Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdById  String?
  createdBy    User?        @relation("InvitesCreated", fields: [createdById], references: [id], onDelete: SetNull)
  tokenHash    String       @unique
  status       InviteStatus @default(PENDING)
  acceptedById String?
  acceptedBy   User?        @relation("InvitesAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)
  expiresAt    DateTime
  createdAt    DateTime     @default(now())
  respondedAt  DateTime?

  @@index([householdId, status])
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

model JoinRequest {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  householdId String
  household   Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  status      JoinRequestStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  respondedAt DateTime?

  @@index([householdId, status])
  @@index([userId, status])
}

// One row per failed login, kept for the rate limiter's sliding window (lib/rateLimit.ts).
// kind is "email" or "ip"; key is the lowercased email or the client IP.
model AuthAttempt {
  id        String   @id @default(cuid())
  kind      String
  key       String
  createdAt DateTime @default(now())

  @@index([kind, key, createdAt])
}

// A single-use link emailed for a forgotten password. Only the token's SHA-256 is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
