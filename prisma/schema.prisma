generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContactCategory {
  FAMILY_FRIEND
  SERVICE_PROVIDER
  MEDICAL_SCHOOL
  HOUSEHOLD_ADMIN
}

// A STANDARD list is the freeform kind. A GROCERY list is the household's shopping list (Meal Planning): its
// items are grouped by store section (ListItem.category) and it can't be renamed, archived, deleted, ranked,
// reordered, assigned or imported through the Lists module. One per household is enforced in the app only.
enum ListKind {
  STANDARD
  GROCERY
}

enum GroceryCategory {
  PRODUCE
  MEAT_SEAFOOD
  DAIRY_EGGS
  BAKERY
  PANTRY
  FROZEN
  BEVERAGES
  SNACKS
  HOUSEHOLD
  OTHER
}

enum ListSortMode {
  MANUAL
  PAIRWISE
}

enum SyncStatus {
  PENDING
  ACTIVE
  DECLINED
  REVOKED
  // An ACTIVE sync that one household later ended.
  ENDED
}

enum EntityType {
  CONTACT
  HOUSEHOLD
}

enum ActivityAction {
  CREATED
  UPDATED
  DELETED
  RESTORED
}

enum ActivitySource {
  CSV_IMPORT
  MANUAL
}

model Household {
  id             String    @id @default(cuid())
  displayName    String
  mailingAddress String?
  tags           String[]
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  contacts        Contact[]       @relation("HouseholdContacts")
  importVersions  ImportVersion[]
  lists           List[]
  meals           Meal[]
  mealPlanEntries MealPlanEntry[]

  syncsInitiated      Sync[]            @relation("SyncInitiator")
  syncsReceived       Sync[]            @relation("SyncCounterpart")
  conversations       Conversation[]
  members             User[]
  // Whose directory this record sits in. Null for a household that is itself an account (its
  // directory is the one it owns); set for the passive households an account recorded.
  ownerHouseholdId    String?
  ownerHousehold      Household?        @relation("Directory", fields: [ownerHouseholdId], references: [id], onDelete: Restrict)
  directoryHouseholds Household[]       @relation("Directory")
  directoryContacts   Contact[]         @relation("ContactDirectory")
  // Optional code that lets a signed-in user without a household ask to join; owners approve.
  joinCode            String?           @unique
  invites             HouseholdInvite[]
  joinRequests        JoinRequest[]

  @@index([ownerHouseholdId])
}

model Contact {
  id                  String          @id @default(cuid())
  householdId         String?
  household           Household?      @relation("HouseholdContacts", fields: [householdId], references: [id])
  firstName           String
  lastName            String
  nickname            String?
  category            ContactCategory
  address             String?
  phoneMobile         String?
  phoneHome           String?
  phoneWork           String?
  emailPrimary        String?
  emailSecondary      String?
  tags                String[]
  favorite            Boolean         @default(false)
  relationshipNotes   String?
  linkedFamilyMember  String?
  importantDate1      String?
  importantDate1Label String?
  importantDate2      String?
  importantDate2Label String?
  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?

  assignedListItems ListItem[]

  syncs            Sync[]
  user             User?
  // The account household whose directory this contact is in (everything is scoped by it).
  ownerHouseholdId String?
  ownerHousehold   Household? @relation("ContactDirectory", fields: [ownerHouseholdId], references: [id], onDelete: Restrict)

  @@index([ownerHouseholdId])
}

// Polymorphic log — entityId can reference either a Contact or Household id.
// No FK constraint intentionally; the entityType field disambiguates.
model ActivityLogEntry {
  id            String         @id @default(cuid())
  entityType    EntityType
  entityId      String
  action        ActivityAction
  changedFields Json?
  source        ActivitySource
  timestamp     DateTime       @default(now())
}

model ImportVersion {
  id                 String    @id @default(cuid())
  householdId        String
  household          Household @relation(fields: [householdId], references: [id])
  importedAt         DateTime  @default(now())
  summary            Json
  contactsSnapshot   Json
  householdsSnapshot Json
}

model List {
  id          String       @id @default(cuid())
  householdId String
  household   Household    @relation(fields: [householdId], references: [id])
  name        String
  tags        String[]
  archivedAt  DateTime?
  sortMode    ListSortMode @default(MANUAL)
  kind        ListKind     @default(STANDARD)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  items ListItem[]
}

model ListItem {
  id                  String           @id @default(cuid())
  listId              String
  list                List             @relation(fields: [listId], references: [id], onDelete: Cascade)
  text                String
  quantity            String?
  assignedToContactId String?
  assignedToContact   Contact?         @relation(fields: [assignedToContactId], references: [id], onDelete: SetNull)
  notes               String?
  checked             Boolean          @default(false)
  checkedAt           DateTime?
  position            Int
  // The store section, for items of a GROCERY list (null in STANDARD lists).
  category            GroceryCategory?
  rating              Float            @default(1500)
  comparisonCount     Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

// A household-to-household handshake, attached to the Contact it was started from.
// A contact counts as "synced" when an ACTIVE Sync points at it (derived, not stored on Contact).
// counterpartHouseholdId stays null until the invited household is a real account.
// Rules (scope/FK pairing, one open sync per contact) are enforced in the app layer with Zod,
// like the other conditional rules in this project, not as DB constraints.
model Sync {
  id                     String     @id @default(cuid())
  initiatingHouseholdId  String
  initiatingHousehold    Household  @relation("SyncInitiator", fields: [initiatingHouseholdId], references: [id], onDelete: Restrict)
  counterpartHouseholdId String?
  counterpartHousehold   Household? @relation("SyncCounterpart", fields: [counterpartHouseholdId], references: [id], onDelete: Restrict)
  relatedContactId       String
  relatedContact         Contact    @relation(fields: [relatedContactId], references: [id], onDelete: Restrict)
  counterpartEmail       String
  // SHA-256 of the invite token in the accept/decline link. The token itself is shown once.
  inviteTokenHash        String     @unique
  status                 SyncStatus @default(PENDING)
  createdAt              DateTime   @default(now())
  respondedAt            DateTime?
  endedAt                DateTime?

  @@index([initiatingHouseholdId])
  @@index([counterpartHouseholdId])
  @@index([relatedContactId])
}

// A channel: only its members can see it. kind GENERAL is each household's automatic channel (householdId
// is that household; membership always equals the household's members). Everything else is a CHANNEL
// whose members were picked by its creator.
model Conversation {
  id          String           @id @default(cuid())
  kind        ConversationKind @default(CHANNEL)
  householdId String?
  household   Household?       @relation(fields: [householdId], references: [id], onDelete: Restrict)
  createdById String?
  createdBy   User?            @relation("ChannelsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  name        String
  archivedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  members  ConversationMember[]
  messages Message[]

  @@index([householdId])
  @@index([kind, householdId])
}

enum ConversationKind {
  CHANNEL
  GENERAL
}

enum ConversationRole {
  MANAGER
  MEMBER
}

model ConversationMember {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation("ChannelMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role           ConversationRole @default(MEMBER)
  addedById      String?
  createdAt      DateTime         @default(now())
  // Messages after this (from other people) count as unread for this member.
  lastReadAt     DateTime         @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

// Messages are never edited and never hard-deleted; deletedAt is the only removal.
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  senderUserId   String?
  sender         User?        @relation("MessagesSent", fields: [senderUserId], references: [id], onDelete: SetNull)
  text           String
  attachmentIds  String[]
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

enum UserRole {
  OWNER
  MEMBER
}

// An individual login (email + own password). A user belongs to at most one household and is
// not usable for any household feature until they do; contactId is the Contact they act as.
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole   @default(MEMBER)
  householdId  String?
  household    Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)
  contactId    String?    @unique
  contact      Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  invitesCreated     HouseholdInvite[]        @relation("InvitesCreated")
  invitesAccepted    HouseholdInvite[]        @relation("InvitesAccepted")
  joinRequests       JoinRequest[]
  // Sessions started before this are signed out (set on password change/reset).
  passwordChangedAt  DateTime?
  resetTokens        PasswordResetToken[]
  // Null until the user confirms the address by clicking the emailed link.
  emailVerifiedAt    DateTime?
  verificationTokens EmailVerificationToken[]
  emailChangeTokens  EmailChangeToken[]

  // Can open /admin (see all users, start password resets, grant superuser). Separate from the
  // household OWNER/MEMBER role.
  isSuperuser             Boolean              @default(false)
  // When they last logged in with a password, and when they were last seen using the app
  // (updated at most every few minutes; see lib/auth.ts).
  lastLoginAt             DateTime?
  lastSeenAt              DateTime?
  adminActionsTaken       AdminAuditEntry[]    @relation("AuditActor")
  adminActionsOnMe        AdminAuditEntry[]    @relation("AuditTarget")
  conversationMemberships ConversationMember[] @relation("ChannelMemberships")
  channelsCreated         Conversation[]       @relation("ChannelsCreated")
  messagesSent            Message[]            @relation("MessagesSent")

  @@index([householdId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

// A single-use link an owner sends to bring one person into the household. Only the token's
// SHA-256 is stored; the link is shown once.
model HouseholdInvite {
  id           String       @id @default(cuid())
  householdId  String
  household    Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdById  String?
  createdBy    User?        @relation("InvitesCreated", fields: [createdById], references: [id], onDelete: SetNull)
  tokenHash    String       @unique
  status       InviteStatus @default(PENDING)
  acceptedById String?
  acceptedBy   User?        @relation("InvitesAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)
  expiresAt    DateTime
  createdAt    DateTime     @default(now())
  respondedAt  DateTime?

  @@index([householdId, status])
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

model JoinRequest {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  householdId String
  household   Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  status      JoinRequestStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  respondedAt DateTime?

  @@index([householdId, status])
  @@index([userId, status])
}

// One row per failed login, kept for the rate limiter's sliding window (lib/rateLimit.ts).
// kind is "email" or "ip"; key is the lowercased email or the client IP.
model AuthAttempt {
  id        String   @id @default(cuid())
  kind      String
  key       String
  createdAt DateTime @default(now())

  @@index([kind, key, createdAt])
}

// A single-use link emailed for a forgotten password. Only the token's SHA-256 is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// A single-use link emailed at signup to prove the address is the user's. Only the token's SHA-256 is stored.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// A single-use link emailed to a NEW address to prove it is the user's before their login email
// changes to it. Only the token's SHA-256 is stored.
model EmailChangeToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// A record of what superusers did in /admin. Never edited or deleted by the app.
model AdminAuditEntry {
  id           String   @id @default(cuid())
  actorId      String?
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUserId String?
  targetUser   User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  action       String
  detail       String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// One row per attempt to send an email, so a delivery problem can be seen (in /admin/email) after the
// fact. Never holds the message body: the links inside are secrets.
model EmailLogEntry {
  id         String   @id @default(cuid())
  toAddress  String
  subject    String
  // SENT, FAILED, or NOT_SENT (no provider configured, as in local development)
  status     String
  // The provider's id for the message when it was accepted, for looking it up in their dashboard.
  providerId String?
  error      String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// ---- Meal Planning ----

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
}

// A library entry: a meal the household has eaten or might. Names are unique per household, ignoring case
// (nameKey is the lowercased, trimmed name). Hard-deleted; see deleteMealAction for what happens to the plan.
model Meal {
  id          String          @id @default(cuid())
  householdId String
  household   Household       @relation(fields: [householdId], references: [id])
  name        String
  nameKey     String
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  entries     MealPlanEntry[]

  @@unique([householdId, nameKey])
}

// A meal (or a one-off text such as "leftovers") on a calendar date and slot. `date` is a plain calendar date.
// Exactly one of mealId / text is set (enforced in the app).
model MealPlanEntry {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  date        DateTime  @db.Date
  slot        MealSlot
  mealId      String?
  meal        Meal?     @relation(fields: [mealId], references: [id], onDelete: SetNull)
  text        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([householdId, date])
  @@index([mealId])
}
